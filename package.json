{
  "name": "fresharena",
  "version": "0.1.0",
  "private": true,
  "description": "FreshArena \u2014 dynamic, verifiable, and adversarial evaluation protocol for coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "solvers/non-llm/*",
    "solvers/llm/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check packages/",
    "lint:fix": "biome check --write packages/",
    "clean": "turbo run clean",
    "verify:sensitive-info": "node scripts/check-no-sensitive-info.mjs",
    "verify:schemas": "node scripts/verify-schemas.mjs",
    "fresharena": "bun run --filter @fresharena/cli start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/bun": "^1.1.0"
  }
}