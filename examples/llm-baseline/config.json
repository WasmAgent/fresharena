{
  "$schema": "../../schemas/evaluation-config.v1.json",
  "name": "llm-baseline",
  "description": "Baseline evaluation configuration for LLM-based solvers (fixed-model track).",
  "track": "model_fixed",
  "world": {
    "path": "worlds/json-transform",
    "task_families": [
      "json_transform.normalize.v0",
      "json_transform.diff_patch.v0",
      "json_transform.merge.v0"
    ]
  },
  "generator": {
    "id": "random-baseline",
    "version": "0.1.0",
    "seed": "llm_baseline_20241215",
    "config": {
      "fresh_task_count": 500,
      "fixed_task_count": 100,
      "admissibility_checks": true
    }
  },
  "solvers": [
    {
      "id": "openai-prompt-v1",
      "path": "solvers/llm/openai-compatible",
      "description": "Basic zero-shot prompt agent using OpenAI GPT-4",
      "model": {
        "provider": "openai",
        "name": "gpt-4",
        "version": "2024-12-01",
        "temperature": 0.0
      },
      "budget": {
        "max_tokens": 4000,
        "max_wall_time_sec": 60,
        "max_attempts": 3
      }
    },
    {
      "id": "anthropic-prompt-v1",
      "path": "solvers/llm/anthropic-compatible",
      "description": "Basic zero-shot prompt agent using Anthropic Claude",
      "model": {
        "provider": "anthropic",
        "name": "claude-sonnet-5",
        "version": "2025-01-01",
        "temperature": 0.0
      },
      "budget": {
        "max_tokens": 4000,
        "max_wall_time_sec": 60,
        "max_attempts": 3
      }
    }
  ],
  "tester": {
    "id": "property-based-tester",
    "version": "0.1.0",
    "enabled": true,
    "config": {
      "strategy": "property-based",
      "test_count_per_task": 50,
      "minimize_counterexamples": true
    }
  },
  "verifier": {
    "package": "json_transform_verifier",
    "version": "0.1.0"
  },
  "output": {
    "path": "records/llm-baseline.jsonl",
    "format": "faep-v0.1.0-jsonl"
  },
  "adversarial": {
    "enabled": true,
    "post_submit": true,
    "test_count": 50
  },
  "immunity_pool": {
    "enabled": true,
    "path": "worlds/json-transform/immunity-pool-v0.json"
  }
}
