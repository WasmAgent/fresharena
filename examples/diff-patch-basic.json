{
  "id": "json-transform.diff-patch.basic.001",
  "family": "json_transform.diff_patch.v0",
  "input_schema": {
    "type": "object",
    "description": "Source and target JSON objects plus optional diff format hint",
    "properties": {
      "source": { "type": "object" },
      "target": { "type": "object" },
      "format": { "type": "string", "enum": ["rfc6902", "inline"] }
    },
    "required": ["source", "target"]
  },
  "output_schema": {
    "type": "array",
    "description": "Minimal patch operations such that apply(patch, source) === target",
    "items": {
      "type": "object",
      "properties": {
        "op": { "type": "string", "enum": ["add", "remove", "replace"] },
        "path": { "type": "string" },
        "value": {}
      },
      "required": ["op", "path"]
    }
  },
  "operation_spec": {
    "type": "diff",
    "constraints": {
      "format": "rfc6902",
      "minimality": "strict",
      "key_order_invariant": true
    }
  },
  "examples": [
    {
      "input": {
        "source": { "a": 1, "b": 2 },
        "target": { "a": 1, "b": 3 }
      },
      "output": [
        { "op": "replace", "path": "/b", "value": 3 }
      ]
    },
    {
      "input": {
        "source": { "a": 1, "b": 2 },
        "target": { "a": 1, "b": 2, "c": 4 }
      },
      "output": [
        { "op": "add", "path": "/c", "value": 4 }
      ]
    },
    {
      "input": {
        "source": { "a": 1, "b": 2, "c": 3 },
        "target": { "a": 1, "c": 3 }
      },
      "output": [
        { "op": "remove", "path": "/b" }
      ]
    }
  ],
  "hidden_tests": {
    "seed_hash": "example-published-nominal",
    "count": 1
  },
  "verifier": {
    "package": "json_transform_verifier",
    "version": "0.1.0"
  },
  "limits": {
    "timeout_ms": 5000,
    "memory_mb": 128,
    "max_source_bytes": 65536
  }
}
