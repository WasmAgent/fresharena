{
  "id": "jt-schema-migration-example-002",
  "family": "json_transform.schema_migration.v0",
  "input_schema": {
    "type": "object",
    "description": "Configuration object with string-based values in v1 format"
  },
  "output_schema": {
    "type": "object",
    "description": "Configuration object migrated to v2 format with proper type conversions"
  },
  "operation_spec": {
    "type": "migrate",
    "constraints": {
      "from_version": "1.0",
      "to_version": "2.0",
      "migration_spec": {
        "type_conversions": {
          "port": "string_to_integer",
          "enabled": "string_to_boolean",
          "timeout": "string_to_integer"
        }
      }
    }
  },
  "examples": [
    {
      "input": {
        "host": "localhost",
        "port": "8080",
        "enabled": "true",
        "timeout": "30"
      },
      "output": {
        "host": "localhost",
        "port": 8080,
        "enabled": true,
        "timeout": 30
      }
    },
    {
      "input": {
        "host": "example.com",
        "port": "443",
        "enabled": "false"
      },
      "output": {
        "host": "example.com",
        "port": 443,
        "enabled": false
      }
    },
    {
      "input": {
        "database": {
          "host": "db.example.com",
          "port": "5432",
          "ssl": "true"
        }
      },
      "output": {
        "database": {
          "host": "db.example.com",
          "port": 5432,
          "ssl": true
        }
      }
    }
  ],
  "hidden_tests": {
    "seed_hash": "sha256:9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7890a1b2c3d4e5f6a7b8c9d0e1f2a3",
    "count": 100
  },
  "verifier": {
    "package": "json_transform_verifier",
    "version": "0.1.0"
  },
  "limits": {
    "timeout_ms": 5000,
    "memory_mb": 256,
    "max_source_bytes": 1048576
  }
}
