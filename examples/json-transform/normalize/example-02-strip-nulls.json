{
  "id": "jt-normalize-example-002",
  "family": "json_transform.normalize.v0",
  "input_schema": {
    "type": "object",
    "description": "A JSON object containing null values at various nesting levels"
  },
  "output_schema": {
    "type": "object",
    "description": "JSON object with all null values recursively removed"
  },
  "operation_spec": {
    "type": "normalize",
    "constraints": {
      "sort_keys": false,
      "strip_nulls": true,
      "flatten": null
    }
  },
  "examples": [
    {
      "input": {
        "name": "Alice",
        "age": null,
        "email": "alice@example.com"
      },
      "output": {
        "name": "Alice",
        "email": "alice@example.com"
      }
    },
    {
      "input": {
        "user": {
          "name": "Bob",
          "nickname": null,
          "metadata": {
            "last_login": null,
            "created_at": "2024-01-01"
          }
        },
        "active": true
      },
      "output": {
        "user": {
          "name": "Bob",
          "metadata": {
            "created_at": "2024-01-01"
          }
        },
        "active": true
      }
    },
    {
      "input": {
        "all_null": {
          "a": null,
          "b": null,
          "c": {
            "d": null
          }
        },
        "preserved": "value"
      },
      "output": {
        "preserved": "value"
      }
    },
    {
      "input": {
        "array_with_nulls": [
          {"a": 1, "b": null},
          {"c": null, "d": 2}
        ],
        "null_element": null
      },
      "output": {
        "array_with_nulls": [
          {"a": 1},
          {"d": 2}
        ]
      }
    }
  ],
  "hidden_tests": {
    "seed_hash": "sha256:7e8f9a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f",
    "count": 100
  },
  "verifier": {
    "package": "json_transform_verifier",
    "version": "0.1.0"
  },
  "limits": {
    "timeout_ms": 5000,
    "memory_mb": 256,
    "max_source_bytes": 1048576
  }
}
